{
  "name": "ecommerce-aigc-video",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "dev:mock": "MODEL_MODE=mock turbo dev",
    "dev:real": "MODEL_MODE=real turbo dev",
    "build": "turbo build",
    "db:clear": "node scripts/clear-postgres.mjs",
    "redis:clear": "node scripts/clear-redis.mjs",
    "reset:dev": "node scripts/reset-dev-session.mjs",
    "realitest": "node scripts/run-realitest.mjs",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "newman": "^6.2.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.20.0",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
