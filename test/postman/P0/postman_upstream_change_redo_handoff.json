{
  "info": {
    "name": "P0 upstream change redo handoff",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Status reports downstream module upstream drift",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('downstream upstream drift is explicit', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.modules.storyboard.upstream).to.have.property('upstreamChanged');",
              "  pm.expect(json.modules.shotprompt.upstream).to.have.property('upstreamChanged');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Active shot set reports shotprompt drift",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('active shot set upstream field exists', function () {",
              "  const shotSet = pm.response.json().activeShotSet;",
              "  if (shotSet) {",
              "    pm.expect(shotSet.upstream).to.have.property('upstreamChanged');",
              "    pm.expect(shotSet.upstream.changedSources).to.be.an('array');",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Workflow status has no duplicate active shot rows",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/shot-workflow-status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('workflow status active shot set scoped', function () {",
              "  const shots = pm.response.json().data.shots;",
              "  const ids = new Set(shots.map(function (shot) { return shot.shotId; }));",
              "  pm.expect(ids.size).to.eql(shots.length);",
              "  shots.forEach(function (shot) {",
              "    pm.expect(shot.upstream).to.have.property('upstreamChanged');",
              "    pm.expect(shot.upstream.changedSources).to.be.an('array');",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Image rounds expose redo handoff upstream drift",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/shots/{{shotId}}/image-rounds"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('image rounds include upstream handoff', function () {",
              "  const rounds = pm.response.json().data;",
              "  rounds.forEach(function (round) {",
              "    pm.expect(round.upstream).to.have.property('upstreamChanged');",
              "    pm.expect(round.upstream.changedSources).to.be.an('array');",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Video rounds expose redo handoff upstream drift",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/shots/{{shotId}}/video-rounds"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('video rounds include upstream handoff', function () {",
              "  const rounds = pm.response.json().data;",
              "  rounds.forEach(function (round) {",
              "    pm.expect(round.upstream).to.have.property('upstreamChanged');",
              "    pm.expect(round.upstream.changedSources).to.be.an('array');",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
