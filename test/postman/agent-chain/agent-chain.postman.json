    },
    {
      "name": "Workspace",
      "item": [
        {
          "name": "Create Workspace",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/workspaces",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{workspaceName}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "var workspace = json.data?.workspace || json.data || json.workspace;",
                  "pm.test(\"workspace id is returned\", function () {",
                  "  pm.expect(workspace.id).to.be.a(\"string\");",
                  "});",
                  "pm.environment.set(\"workspaceId\", workspace.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Bind Local Storage",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/storage/bind",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"local\",\n  \"localPath\": \"{{workspaceDirectory}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "var payload = json.data || json;",
                  "var storage = payload.storage || payload;",
                  "pm.test(\"local storage is bound\", function () {",
                  "  pm.expect(storage.bound === true || storage.kind === \"LOCAL\" || storage.kind === \"local\").to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Workspace Material",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/materials",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"{{materialRef}}\",\n  \"dataBase64\": \"{{materialFileBase64}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "var asset = json.data?.asset || json.asset || json.data || json;",
                  "pm.test(\"workspace material has stable URL\", function () {",
                  "  pm.expect(asset.url || asset.material?.url).to.be.a(\"string\");",
                  "  pm.expect(asset.url || asset.material?.url).to.include(pm.environment.get(\"workspaceId\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Prompt Requirements",
      "item": [
        {
          "name": "Propose Prompt Requirements",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/prompt-requirements/propose",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"image\": {\n      \"style\": \"{{imageStyle}}\",\n      \"composition\": \"{{imageComposition}}\",\n      \"avoid\": [\"{{imageAvoid}}\"]\n    },\n    \"script\": {\n      \"tone\": \"{{scriptTone}}\"\n    },\n    \"storyboard\": {\n      \"rhythm\": \"{{storyboardRhythm}}\"\n    },\n    \"shotImage\": {\n      \"global\": \"{{shotImageGlobal}}\"\n    },\n    \"shotVideo\": {\n      \"global\": \"{{shotVideoGlobal}}\"\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "var artifact = json.data?.artifact || json.data;",
                  "pm.test(\"proposed requirements artifact is returned\", function () {",
                  "  pm.expect(artifact.moduleId).to.eql(\"prompt-requirements\");",
                  "  pm.expect(artifact.status).to.eql(\"proposed\");",
                  "  pm.expect(artifact.isCurrent).to.eql(false);",
                  "  pm.expect(artifact.data.shotImage).to.be.an(\"object\");",
                  "  pm.expect(artifact.data.shotVideo).to.be.an(\"object\");",
                  "});",
                  "pm.environment.set(\"promptRequirementsProposedArtifactId\", artifact.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve Prompt Requirements",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/prompt-requirements/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artifactId\": \"{{promptRequirementsProposedArtifactId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "var artifact = json.data?.artifact || json.data;",
                  "pm.test(\"approved requirements artifact is current\", function () {",
                  "  pm.expect(artifact.moduleId).to.eql(\"prompt-requirements\");",
                  "  pm.expect(artifact.status).to.eql(\"approved\");",
                  "  pm.expect(artifact.isCurrent).to.eql(true);",
                  "});",
                  "pm.environment.set(\"promptRequirementsArtifactId\", artifact.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Prompt Requirements State",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/prompt-requirements"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var state = pm.response.json().data;",
                  "pm.test(\"current requirements match approved artifact\", function () {",
                  "  pm.expect(state.moduleId).to.eql(\"prompt-requirements\");",
                  "  pm.expect(state.current.id).to.eql(pm.environment.get(\"promptRequirementsArtifactId\"));",
                  "  pm.expect(state.current.status).to.eql(\"approved\");",
                  "  pm.expect(state.proposed).to.not.eql(null);",
                  "  pm.expect(state.upstream.upstreamChanged).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
