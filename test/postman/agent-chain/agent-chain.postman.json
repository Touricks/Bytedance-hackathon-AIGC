                  "var state = pm.response.json().data;",
                  "pm.test(\"current shotprompt matches approved artifact\", function () {",
                  "  pm.expect(state.moduleId).to.eql(\"shotprompt\");",
                  "  pm.expect(state.current.id).to.eql(pm.environment.get(\"shotPromptArtifactId\"));",
                  "  pm.expect(state.current.status).to.eql(\"approved\");",
                  "  pm.expect(state.proposed).to.not.eql(null);",
                  "  pm.expect(state.upstream.upstreamChanged).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Shot Sets",
      "item": [
        {
          "name": "List Shots Before Apply",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/shots"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(400);",
                  "var json = pm.response.json();",
                  "pm.test(\"shots require active shot set\", function () {",
                  "  pm.expect(json.code).to.eql(\"NO_ACTIVE_SHOT_SET\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Apply Shot Set",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/shot-sets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shotPromptArtifactId\": \"{{shotPromptArtifactId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var shotSet = pm.response.json().data;",
                  "pm.test(\"active shot set is created\", function () {",
                  "  pm.expect(shotSet.status).to.eql(\"active\");",
                  "  pm.expect(shotSet.shotPromptArtifactId).to.eql(pm.environment.get(\"shotPromptArtifactId\"));",
                  "});",
                  "pm.environment.set(\"shotSetId\", shotSet.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Active Shots",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/shots"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var shots = pm.response.json().data;",
                  "pm.test(\"active shots match shot set and include requirements\", function () {",
                  "  pm.expect(shots.length).to.eql(Number(pm.environment.get(\"shotPromptShotCount\")));",
                  "  for (const shot of shots) {",
                  "    pm.expect(shot.shotSetId).to.eql(pm.environment.get(\"shotSetId\"));",
                  "    pm.expect(shot.requirements.shotImage).to.be.an(\"object\");",
                  "    pm.expect(shot.requirements.shotVideo).to.be.an(\"object\");",
                  "  }",
                  "});",
                  "pm.environment.set(\"shotIds\", JSON.stringify(shots.map((shot) => shot.id)));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
