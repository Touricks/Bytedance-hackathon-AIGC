{
  "info": {
    "name": "Bytedancehack V2 Agent Chain",
    "description": "TDD tracer collection for the V2 module artifact chain. It starts with prompt requirements propose/approve through public HTTP APIs, then grows vertically with each backend slice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"response is not 5xx\", function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "var contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "if (contentType.includes(\"application/json\")) {",
          "  pm.response.json();",
          "}"
        ]
      }
    }
  ],
