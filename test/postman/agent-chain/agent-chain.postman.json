  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "pm.test(\"health is ok\", function () {",
                  "  pm.expect(json.ok).to.eql(true);",
                  "  pm.expect(json.runtime).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Config Limits",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/config/limits"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var data = pm.response.json().data;",
                  "pm.test(\"generation limits exist\", function () {",
