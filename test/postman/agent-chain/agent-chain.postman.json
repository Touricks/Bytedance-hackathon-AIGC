                  "pm.response.to.have.status(200);",
                  "var artifact = pm.response.json().data?.artifact || pm.response.json().data;",
                  "pm.test(\"proposed shotprompt artifact is returned with per-shot requirements\", function () {",
                  "  pm.expect(artifact.moduleId).to.eql(\"shotprompt\");",
                  "  pm.expect(artifact.status).to.eql(\"proposed\");",
                  "  pm.expect(artifact.isCurrent).to.eql(false);",
                  "  pm.expect(artifact.sourceFingerprint.storyboardArtifactId).to.eql(pm.environment.get(\"storyboardArtifactId\"));",
                  "  pm.expect(artifact.data.shots).to.be.an(\"array\");",
                  "  pm.expect(artifact.data.shots.length).to.be.above(0);",
                  "  for (const shot of artifact.data.shots) {",
                  "    pm.expect(shot.shotImage).to.be.an(\"object\");",
                  "    pm.expect(shot.shotVideo).to.be.an(\"object\");",
                  "  }",
                  "});",
                  "pm.environment.set(\"shotPromptShotCount\", String(artifact.data.shots.length));",
                  "pm.environment.set(\"shotPromptProposedArtifactId\", artifact.id);"
