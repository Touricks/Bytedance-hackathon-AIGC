# App
NODE_ENV=development
WEB_PORT=5173
SERVER_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000

# Storage and queue
# Required: Postgres is the only supported V0 fact source.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aigc_video
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=tmp/uploads
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aigc-video

# Volcengine Ark/OpenAPI
MODEL_MODE=mock
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_TEXT_ENDPOINT_ID=
ARK_VIDEO_ENDPOINT_ID=

# OpenAI-compatible fallback LLM for creative-blueprint recovery only.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TOP_P=0.9
OPENAI_TEMPERATURE=0.7

# Real-provider smoke input
SMOKE_PRODUCT_IMAGE_URL=
SMOKE_PRODUCT_TITLE=Portable Mini Blender
SMOKE_SELLING_POINTS=USB-C charging, easy cleaning, powerful smoothie blending
SMOKE_AUDIENCE=busy office workers
SMOKE_STYLE_PREFERENCE=clean premium ecommerce

# Demo fallback
MOCK_FINAL_VIDEO_URL=/mocks/videos/fallback-flower.mp4
