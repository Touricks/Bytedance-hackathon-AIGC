# App
# V1 real-demo template. Copy to .env, then fill the paid Ark values locally.
# Do not commit real API keys, endpoint IDs, credentials, or local secrets.
WEB_PORT=5173
SERVER_PORT=3000
PUBLIC_API_BASE_URL=http://localhost

# Runtime storage and queue
# Postgres is the V1 business fact source.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aigc_video
REDIS_URL=redis://localhost:6379
USE_REDIS_QUEUE=true

# Optional local object-storage experiment; not required for the V1 workspace path.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aigc-video

# Volcengine Ark/OpenAPI
# MODEL_MODE=real makes builder stages call Ark text providers.
MODEL_MODE=real

# Per-task model providers (text / image / video each independent).
# These are the preferred explicit fields. ARK_* aliases still work in code 
TEXT_API_KEY=
TEXT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TEXT_ENDPOINT_ID=
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_ENDPOINT_ID=
VIDEO_API_KEY=
VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_ENDPOINT_ID=

# Candidate counts (per-shot generation). Defaults are applied when the client
# omits count; max values are hard server-enforced per-shot caps.
DEFAULT_IMAGE_CANDIDATES=3
MAX_IMAGE_CANDIDATES_PER_SHOT=6
DEFAULT_VIDEO_CANDIDATES=2
MAX_VIDEO_CANDIDATES_PER_SHOT=5

# Queue/provider concurrency. Worker concurrency caps BullMQ job execution;
# provider concurrency caps simultaneous Ark/Seedance calls at the package
# boundary. IMAGE_PROVIDER_CONCURRENCY defaults to 2x max image candidates when
# omitted; GENERATION_WORKER_CONCURRENCY defaults to image+video provider caps.
GENERATION_WORKER_CONCURRENCY=17
TEXT_PROVIDER_CONCURRENCY=20
IMAGE_PROVIDER_CONCURRENCY=12
VIDEO_PROVIDER_CONCURRENCY=5

# Ark rate-limit handling. The shared text+video account may have fewer slots
# available at runtime (multi-session), so 429/5xx/timeout responses are retried
# with exponential backoff + jitter (Retry-After honored when present).
ARK_MAX_RETRIES=4
ARK_RETRY_BASE_MS=2000
