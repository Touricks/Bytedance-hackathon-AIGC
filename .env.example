# App
NODE_ENV=development
WEB_PORT=5173
SERVER_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000

# Storage and queue
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aigc_video
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=tmp/uploads
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aigc-video

# Volcengine Ark/OpenAPI
ARK_API_KEY=
ARK_TEXT_ENDPOINT_ID=
ARK_VIDEO_ENDPOINT_ID=

# Seedance image-to-video provider
SEEDANCE_API_URL=
SEEDANCE_API_KEY=
SEEDANCE_MODEL=

# OpenAI-compatible runtime for Ark text generation
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TOP_P=0.9
OPENAI_TEMPERATURE=0.7

# Demo fallback
MOCK_FINAL_VIDEO_URL=/mocks/videos/fallback-flower.mp4
