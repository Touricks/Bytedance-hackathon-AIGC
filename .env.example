# App
# V1 real-demo template. Copy to .env, then fill the paid Ark values locally.
# Do not commit real API keys, endpoint IDs, credentials, or local secrets.
NODE_ENV=development
WEB_PORT=5173
SERVER_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000

# Runtime storage and queue
# Postgres is the V1 business fact source.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aigc_video
REDIS_URL=redis://localhost:6379
USE_REDIS_QUEUE=
WORKSPACE_DIR=storage/workspaces

# Optional local object-storage experiment; not required for the V1 workspace path.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aigc-video

# Volcengine Ark/OpenAPI
# MODEL_MODE=real makes builder stages call Ark text providers.
# Seedance video export always requires ARK_API_KEY + ARK_VIDEO_ENDPOINT_ID.
MODEL_MODE=real
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_TEXT_ENDPOINT_ID=
ARK_VIDEO_ENDPOINT_ID=

# Per-task model providers (text / image / video each independent).
# TEXT_* and VIDEO_* fall back to ARK_* for backward compatibility.
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_ENDPOINT_ID=
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_ENDPOINT_ID=
VIDEO_API_KEY=
VIDEO_BASE_URL=
VIDEO_ENDPOINT_ID=

# Batch sizing (per-shot generation). Default applied when client omits count;
# max is a hard server-enforced cap.
DEFAULT_IMAGE_BATCH_SIZE=3
MAX_IMAGE_BATCH_SIZE=6
DEFAULT_VIDEO_BATCH_SIZE=5
MAX_VIDEO_BATCH_SIZE=10
