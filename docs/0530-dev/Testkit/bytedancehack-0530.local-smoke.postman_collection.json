    {
      "name": "Workspace Local Contract",
      "item": [
        {
          "name": "Create Logical Workspace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspaces",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{workspaceName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const json = pm.response.json();",
                  "pm.test(\"workspace created unbound\", function () {",
                  "  pm.expect(json.workspace.id).to.be.a(\"string\");",
                  "  pm.expect(json.workspace.currentScriptId).to.be.a(\"string\");",
                  "  pm.expect(json.storage.bound).to.eql(false);",
                  "});",
                  "pm.collectionVariables.set(\"workspaceId\", json.workspace.id);",
                  "pm.collectionVariables.set(\"scriptId\", json.workspace.currentScriptId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Workspace Status Before Storage Binding",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspaces/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceId\": \"{{workspaceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const json = pm.response.json();",
                  "pm.test(\"unbound workspace asks for storage binding\", function () {",
                  "  pm.expect(json.storage.bound).to.eql(false);",
                  "  pm.expect(json.nextAction).to.eql(\"BIND_STORAGE\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Bind Local Storage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/storage/bind",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"local\",\n  \"localPath\": \"{{workspaceDirectory}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const storage = pm.response.json().data.storage;",
                  "pm.test(\"storage bound\", function () {",
                  "  pm.expect(storage.bound).to.eql(true);",
                  "  pm.expect(storage.kind).to.eql(\"local\");",
                  "  const expected = pm.collectionVariables.get(\"workspaceDirectory\").replace(/\\/+$/, \"\");",
                  "  pm.expect(storage.localPath.replace(/\\/+$/, \"\")).to.eql(expected);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Workspace Storage",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/storage"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const storage = pm.response.json().data.storage;",
                  "pm.test(\"storage is readable\", function () {",
                  "  pm.expect(storage.bound).to.eql(true);",
                  "  pm.expect(storage.kind).to.eql(\"local\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Fixed Material",
