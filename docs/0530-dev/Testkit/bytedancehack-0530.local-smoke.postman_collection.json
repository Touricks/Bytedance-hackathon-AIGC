            "url": "{{baseUrl}}/api/workspaces/artifacts/shotprompt/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceId\": \"{{workspaceId}}\",\n  \"data\": {\n    \"targetProvider\": \"seedance\",\n    \"durationSec\": 4,\n    \"aspectRatio\": \"9:16\",\n    \"prompt\": \"保持产品外观一致，生成一个四秒广告镜头。\",\n    \"negativePrompt\": \"不要水印，不要乱码字幕，不要改变商品外观。\",\n    \"shots\": [\n      {\n        \"index\": 0,\n        \"startSec\": 0,\n        \"endSec\": 4,\n        \"providerPrompt\": \"桌面产品开场，稳定展示产品外观，保持真实质感和干净背景。\",\n        \"referenceAssetRefs\": [\"{{materialRef}}\"],\n        \"voiceover\": \"快速生成一条商品广告。\"\n      }\n    ],\n    \"tts\": {\n      \"enabled\": true,\n      \"source\": \"shots.voiceover\",\n      \"voiceover\": \"快速生成一条商品广告。\"\n    },\n    \"assumptions\": [\"Postman smoke 使用固定 shotprompt，避免调用文本模型。\"]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const json = pm.response.json();",
                  "pm.test(\"fixed shotprompt approved\", function () {",
                  "  pm.expect(json.artifact.id).to.be.a(\"string\");",
                  "  pm.expect(json.artifact.type).to.eql(\"shotprompt\");",
                  "  pm.expect(json.artifact.status).to.eql(\"approved\");",
                  "});",
                  "pm.collectionVariables.set(\"shotPromptArtifactId\", json.artifact.id);"
                ]
              }
            }
          ]
        },
