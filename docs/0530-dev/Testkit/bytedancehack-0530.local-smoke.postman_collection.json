              }
            ],
            "url": "{{baseUrl}}/api/workspaces/materials",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceId\": \"{{workspaceId}}\",\n  \"filename\": \"{{materialRef}}\",\n  \"dataBase64\": \"{{materialFileBase64}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
