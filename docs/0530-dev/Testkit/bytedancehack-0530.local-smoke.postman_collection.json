            "url": "{{baseUrl}}/api/shots/{{shotId}}/image-batches",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imagePromptArtifactId\": \"missing-image-prompt-artifact\",\n  \"count\": 1,\n  \"aspectRatio\": \"9:16\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 idempotency required\", function () {",
                  "  pm.expect(pm.response.code).to.eql(400);",
                  "  pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_KEY_REQUIRED\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Final Video Missing Selections",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-final-negative-{{$timestamp}}"
              }
            ],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/final-videos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outputAspectRatio\": \"9:16\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"final compose requires selected videos\", function () {",
                  "  pm.expect(pm.response.code).to.eql(409);",
                  "  pm.expect(pm.response.json().code).to.eql(\"MISSING_SELECTIONS\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
