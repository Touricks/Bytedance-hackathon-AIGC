                  "const json = pm.response.json();",
                  "pm.test(\"material uploaded without provider\", function () {",
                  "  pm.expect(json.material.assetId).to.be.a(\"string\");",
                  "  pm.expect(json.material.url).to.include(\"/api/workspaces/\" + pm.collectionVariables.get(\"workspaceId\") + \"/materials/\");",
                  "});",
