              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const json = pm.response.json();",
                  "pm.test(\"bound workspace reports material library\", function () {",
                  "  pm.expect(json.storage.bound).to.eql(true);",
