                  "if (first && first.activeImageBatchId) pm.collectionVariables.set('imageBatchId', first.activeImageBatchId);",
                  "if (first && first.activeVideoBatchId) pm.collectionVariables.set('videoBatchId', first.activeVideoBatchId);"
                ]
