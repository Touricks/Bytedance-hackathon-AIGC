                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) pm.collectionVariables.set('videoScriptArtifactId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationSec\": 5,\n  \"useNeighborFrames\": true,\n  \"userHint\": \"Use gentle motion and keep the product readable.\"\n}"
            },
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/shots/{{shotId}}/video-scripts/propose"
          }
        },
        {
          "name": "Patch Video Script",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) pm.collectionVariables.set('videoScriptArtifactId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseVersion\": 1,\n  \"durationSec\": 5,\n  \"scriptJson\": {\n    \"durationSec\": 5,\n    \"providerPrompt\": \"A polished vertical product video with slow push-in, clear product focus, clean background, and commercial lighting.\"\n  },\n  \"providerPrompt\": \"A polished vertical product video with slow push-in, clear product focus, clean background, and commercial lighting.\"\n}"
            },
            "url": "{{baseUrl}}/api/shots/{{shotId}}/video-scripts/{{videoScriptArtifactId}}"
          }
        },
        {
          "name": "List Video Scripts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shots/{{shotId}}/video-scripts"
          }
        },
        {
          "name": "Create Video Batch",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "if (data.batchId || data.id) pm.collectionVariables.set('videoBatchId', data.batchId || data.id);",
                  "if (data.jobId) pm.collectionVariables.set('jobId', data.jobId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "video-batch-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"videoScriptArtifactId\": \"{{videoScriptArtifactId}}\",\n  \"count\": 3,\n  \"aspectRatio\": \"9:16\"\n}"
            },
            "url": "{{baseUrl}}/api/shots/{{shotId}}/video-batches"
          }
        },
        {
          "name": "List Video Batches - Currently 501",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shots/{{shotId}}/video-batches"
          }
        },
        {
          "name": "Get Video Batch",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "if (data.batchId || data.id) pm.collectionVariables.set('videoBatchId', data.batchId || data.id);",
                  "const candidates = data.candidates || [];",
                  "const candidate = candidates.find((c) => c.status === 'SUCCEEDED') || candidates[0];",
                  "if (candidate && candidate.id) pm.collectionVariables.set('videoCandidateId', candidate.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shots/{{shotId}}/video-batches/{{videoBatchId}}"
          }
        },
        {
          "name": "Select Video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"videoCandidateId\": \"{{videoCandidateId}}\",\n  \"videoGenerationBatchId\": \"{{videoBatchId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/shots/{{shotId}}/selected-video"
          }
        },
        {
          "name": "Get Selected Video",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shots/{{shotId}}/selected-video"
          }
        },
        {
          "name": "Retry Image Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "retry-image-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"what\": \"image_batch\"\n}"
            },
            "url": "{{baseUrl}}/api/shots/{{shotId}}/retry"
          }
        },
        {
          "name": "Retry Video Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "retry-video-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"what\": \"video_batch\"\n}"
            },
            "url": "{{baseUrl}}/api/shots/{{shotId}}/retry"
          }
        }
      ]
    },
    {
      "name": "Final Video",
      "item": [
        {
          "name": "Create Final Video",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "if (data.finalVideoJobId || data.id) pm.collectionVariables.set('finalVideoJobId', data.finalVideoJobId || data.id);",
                  "if (data.jobId) pm.collectionVariables.set('jobId', data.jobId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "final-video-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outputAspectRatio\": \"9:16\"\n}"
            },
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/final-videos"
          }
        },
        {
          "name": "Get Final Video Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) pm.collectionVariables.set('finalVideoJobId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/final-videos/{{finalVideoJobId}}"
          }
        },
        {
          "name": "List Workspace Final Videos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/final-videos"
          }
        },
        {
          "name": "Download Final Video File",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/final-videos/{{finalVideoJobId}}/file"
          }
        }
      ]
    },
    {
      "name": "Trace",
      "item": [
        {
          "name": "List Workspace Traces",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/traces?limit=50&cursor={{traceCursor}}"
          }
        },
        {
          "name": "List Shot Traces",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shots/{{shotId}}/traces?limit=50&cursor={{traceCursor}}"
          }
        }
      ]
    },
    {
      "name": "Static Files",
      "item": [
        {
          "name": "Get Workspace Material File",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/materials/{{materialRef}}"
          }
        },
        {
          "name": "Get Workspace Video File",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/videos/{{videoRelativePath}}"
          }
        }
      ]
    },
    {
      "name": "Test Utilities",
      "item": [
        {
          "name": "Delete Test Run",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/test-runs/{{workspaceName}}"
          }
        }
      ]
    }
  ]
}
