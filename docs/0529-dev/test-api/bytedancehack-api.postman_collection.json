              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const first = json.data && json.data[0];",
                  "if (first && first.id) pm.collectionVariables.set('shotId', first.id);",
                  "if (first && first.activeImagePromptArtifactId) pm.collectionVariables.set('imagePromptArtifactId', first.activeImagePromptArtifactId);",
                  "if (first && first.activeVideoScriptArtifactId) pm.collectionVariables.set('videoScriptArtifactId', first.activeVideoScriptArtifactId);",
                  "if (first && first.selectedImageId) pm.collectionVariables.set('imageCandidateId', first.selectedImageId);",
                  "if (first && first.selectedVideoId) pm.collectionVariables.set('videoCandidateId', first.selectedVideoId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/shots"
          }
