          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shots/{{shotId}}/image-prompts"
          }
        },
        {
          "name": "Create Image Batch",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "if (data.batchId || data.id) pm.collectionVariables.set('imageBatchId', data.batchId || data.id);",
                  "if (data.jobId) pm.collectionVariables.set('jobId', data.jobId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "image-batch-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imagePromptArtifactId\": \"{{imagePromptArtifactId}}\",\n  \"count\": 3,\n  \"aspectRatio\": \"9:16\"\n}"
            },
            "url": "{{baseUrl}}/api/shots/{{shotId}}/image-batches"
          }
        },
        {
          "name": "List Image Batches - Currently 501",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shots/{{shotId}}/image-batches"
          }
        },
        {
          "name": "Get Image Batch",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "if (data.batchId || data.id) pm.collectionVariables.set('imageBatchId', data.batchId || data.id);",
                  "const candidates = data.candidates || [];",
                  "const candidate = candidates.find((c) => c.status === 'SUCCEEDED') || candidates[0];",
                  "if (candidate && candidate.id) pm.collectionVariables.set('imageCandidateId', candidate.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shots/{{shotId}}/image-batches/{{imageBatchId}}"
          }
        },
