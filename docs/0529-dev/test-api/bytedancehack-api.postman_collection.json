              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const first = json.workspaces && json.workspaces[0];",
                  "if (first && !pm.collectionVariables.get('workspaceId')) {",
                  "  pm.collectionVariables.set('workspaceId', first.id);",
                  "  pm.collectionVariables.set('scriptId', first.currentScriptId || '');",
