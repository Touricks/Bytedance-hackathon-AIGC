{
  "name": "@aigc-video/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/prompts','dist/prompts',{recursive:true,filter:(s)=>!/\\.(ts|tsx)$/.test(s)})\"",
    "pretest": "pnpm --filter @aigc-video/shared build",
    "test": "TRACE_LOG_SCOPE=tests AIGC_VIDEO_SKIP_ENV_FILE=true MODEL_MODE=mock ARK_API_KEY= ARK_TEXT_ENDPOINT_ID= ARK_VIDEO_ENDPOINT_ID= node --import tsx --test \"src/**/*.test.ts\"",
    "probe:to-text": "tsx src/probes/to-text.ts",
    "probe:image-to-video": "tsx src/probes/image-to-video.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@aigc-video/shared": "workspace:*",
    "@openai/agents": "^0.0.5",
    "openai": "^4.86.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
