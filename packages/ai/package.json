{
  "name": "@aigc-video/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @aigc-video/shared build",
    "test": "AIGC_VIDEO_SKIP_ENV_FILE=true MODEL_MODE=mock ARK_API_KEY= ARK_TEXT_ENDPOINT_ID= ARK_VIDEO_ENDPOINT_ID= OPENAI_API_KEY= OPENAI_MODEL= node --import tsx --test \"src/**/*.test.ts\"",
    "probe:to-text": "tsx src/probes/to-text.ts",
    "probe:image-to-video": "tsx src/probes/image-to-video.ts",
    "smoke:real-providers": "MODEL_MODE=real tsx src/smoke/real-providers.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@aigc-video/shared": "workspace:*",
    "openai": "^4.86.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
