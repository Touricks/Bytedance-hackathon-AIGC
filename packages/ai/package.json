{
  "name": "@aigc-video/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @aigc-video/shared build",
    "test": "MODEL_MODE=mock OPENAI_API_KEY= OPENAI_MODEL= ARK_TEXT_ENDPOINT_ID= SEEDANCE_API_URL= SEEDANCE_API_KEY= node --import tsx --test \"src/**/*.test.ts\"",
    "smoke:real-providers": "MODEL_MODE=real tsx src/smoke/real-providers.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@aigc-video/shared": "workspace:*",
    "openai": "^4.86.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
